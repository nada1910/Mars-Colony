<mxCell id="n28" value="Habitat A oxygen: 300 - 30 = 270.  Emergency status = RESPONDING." style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="385" y="629" width="335" height="34" as="geometry"/></mxCell>
<mxCell id="n48" value="Scientist, MedicalOfficer and ExplorationRover are queried too, but canRespondTo(leak) is false. Result: responders = [farah, fixer1], hasCrew = hasRobot = true." style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="755" y="987" width="705" height="58" as="geometry"/></mxCell>
<mxCell id="n61" value="Reason: &amp;quot;No suitable responders available&amp;quot; or &amp;quot;Oxygen leak requires a crew member and a robot&amp;quot;. Total oxygen lost = 30 + 30 = 60; Habitat A stays leaking = true." style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="385" y="1259" width="890" height="44" as="geometry"/></mxCell>
<mxCell id="n77" value="return false: nothing is consumed." style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1125" y="1601" width="150" height="44" as="geometry"/></mxCell>
