<mxCell id="n157" value="Result: leak = false, habitatA.leaking = false, status = RESOLVED, farah and fixer1 released. storage: SPARE_PARTS 10 - 2 = 8, BATTERY_POWER 50 - 5 = 45." style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="385" y="2973" width="890" height="48" as="geometry"/></mxCell>
