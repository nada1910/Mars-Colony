<mxfile host="app.diagrams.net"><diagram id="oxygen-leak-sequence" name="Oxygen Leak Emergency"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="3181" math="0" shadow="0"><root>
